---
interface Attachment {
  label: string;
  file: string;
  note?: string;
}
interface Props {
  attachments: Attachment[];
  heading?: string;
}
const { attachments, heading = 'Матеріали до теми' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{
  attachments.length > 0 && (
    <section class="attachments">
      <div class="mono-label" style="margin-bottom: 14px">{heading}</div>
      <ul class="attachments__list">
        {attachments.map((a) => (
          <li>
            <a class="attachments__item" href={`${base}/pdf/${a.file}`} target="_blank" rel="noopener">
              <span class="attachments__icon" aria-hidden="true">PDF</span>
              <span class="attachments__text">
                <span class="attachments__label">{a.label}</span>
                {a.note && <span class="attachments__note">{a.note}</span>}
              </span>
              <span class="attachments__open">Відкрити →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
