---
/**
 * Slide 14 — the real domain is the two labels before the first slash.
 *
 * Built in CSS grid rather than SVG on purpose: this is annotated text, and the
 * brackets have to line up with glyphs whose widths only the browser knows. An
 * earlier SVG version positioned segments by a hardcoded character advance and
 * the labels overlapped.
 */
---
<div class="dom">
  <span class="dom__label dom__label--above">просто текст</span>
  <span class="dom__bracket dom__bracket--above"></span>

  <span class="dom__seg dom__seg--dim">https://</span>
  <span class="dom__seg dom__seg--decoy">google.com.</span>
  <span class="dom__seg dom__seg--real">security-check.ru</span>
  <span class="dom__seg dom__seg--dim">/login</span>

  <span class="dom__bracket dom__bracket--below"></span>
  <span class="dom__label dom__label--below">справжній сайт</span>

  <span class="dom__read">
    <span class="dom__arrow"></span>
    читаємо справа наліво
  </span>
</div>

<style>
  /* Five rows: label above · bracket above · the URL · bracket below · label
     below. Four columns, one per URL segment, each sized by its own text — so
     every bracket and label lands under exactly the right glyphs. */
  .dom {
    display: grid;
    grid-template-columns: auto auto auto auto;
    grid-template-rows: auto auto auto auto auto auto;
    justify-content: center;
    align-content: center;
    row-gap: max(4px, 0.5cqw);
    font-family: var(--mono);
  }

  .dom__seg {
    grid-row: 3;
    font-size: max(15px, 2.5cqw);
    line-height: 1.3;
    white-space: pre;
  }
  .dom__seg--dim {
    opacity: 0.4;
  }
  .dom__seg--decoy {
    opacity: 0.55;
  }
  .dom__seg--real {
    color: var(--accent);
    font-weight: 600;
  }

  .dom__bracket {
    height: max(8px, 1.1cqw);
  }
  .dom__bracket--above {
    grid-row: 2;
    grid-column: 2;
    border: 2px solid currentColor;
    border-bottom: none;
    opacity: 0.4;
  }
  .dom__bracket--below {
    grid-row: 4;
    grid-column: 3;
    border: 2px solid var(--accent);
    border-top: none;
  }

  .dom__label {
    font-family: var(--sans);
    font-size: max(12px, 1.5cqw);
    text-align: center;
  }
  .dom__label--above {
    grid-row: 1;
    grid-column: 2;
    opacity: 0.65;
  }
  .dom__label--below {
    grid-row: 5;
    grid-column: 3;
    color: var(--accent);
    font-weight: 600;
  }

  /* Read direction, spanning the part of the URL that actually matters. */
  .dom__read {
    grid-row: 6;
    grid-column: 2 / 4;
    margin-top: max(14px, 2cqw);
    display: flex;
    align-items: center;
    gap: max(8px, 1cqw);
    font-family: var(--sans);
    font-size: max(11px, 1.35cqw);
    opacity: 0.6;
  }
  .dom__arrow {
    flex: 1;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .dom__arrow::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: max(7px, 0.8cqw);
    height: max(7px, 0.8cqw);
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
    transform-origin: left center;
  }
</style>
