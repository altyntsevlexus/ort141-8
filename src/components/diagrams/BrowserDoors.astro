---
/**
 * Slide 11 — the browser is not one program but a pile of conveniences, and
 * each convenience is also a way in.
 *
 * Four tools rather than three, and cookies are not among them: session
 * hijacking was cut from this lesson, so naming cookies here would promise a
 * slide that no longer exists.
 */
import { TYPE, VB } from './_shared';

const WIN = { x: 330, y: 52, w: 340, h: 246 };

/** Each tool gets its own glyph: identical arrows would leave the labels to do
    all the work, which is the mistake the malware doors made. */
const GLYPHS: Record<string, string> = {
  /** A puzzle piece: an extension. */
  puzzle: 'M-11 -12 h20 v6 a6 6 0 1 1 0 12 v6 h-20 z',
  /** A padlock over a list: passwords the browser keeps for you. */
  vault: 'M-12 -3 h24 v15 h-24 z M-6 -3 v-6 a6 6 0 0 1 12 0 v6',
  /** Two windows, one a copy of the other: a substituted page. */
  copy: 'M-13 -11 h18 v15 h-18 z M-5 -4 h18 v15 h-18 z',
  /** A field that filled itself in: autofill. A plain square read as nothing. */
  form: 'M-13 -9 h26 v18 h-26 z M-7 0 l4 5 l9 -10',
};

const TOOLS = [
  { label: 'розширення', glyph: 'puzzle', at: { x: 106, y: 108 }, to: { x: WIN.x - 12, y: 118 } },
  { label: 'збережені паролі', glyph: 'vault', at: { x: 106, y: 268 }, to: { x: WIN.x - 12, y: 232 } },
  { label: 'підмінені сторінки', glyph: 'copy', at: { x: 894, y: 108 }, to: { x: WIN.x + WIN.w + 12, y: 118 } },
  { label: 'автозаповнення', glyph: 'form', at: { x: 894, y: 268 }, to: { x: WIN.x + WIN.w + 12, y: 232 } },
];
---
<svg viewBox={`0 0 ${VB.w} ${VB.h}`} role="img"
     aria-label="Розширення, збережені паролі, підмінені сторінки та автозаповнення — усе це інструменти одного браузера">
  <!-- The browser: chrome bar, address pill, page. -->
  <rect x={WIN.x} y={WIN.y} width={WIN.w} height={WIN.h} rx="12"
        fill="none" stroke="currentColor" stroke-width="2.5" />
  <path d={`M${WIN.x} ${WIN.y + 44} h ${WIN.w}`} stroke="currentColor" stroke-width="2" opacity="0.45" />
  {[0, 1, 2].map((i) => (
    <circle cx={WIN.x + 24 + i * 20} cy={WIN.y + 22} r="5" fill="currentColor" opacity="0.35" />
  ))}
  <rect x={WIN.x + 96} y={WIN.y + 10} width={WIN.w - 120} height="24" rx="12"
        fill="currentColor" opacity="0.1" />
  {[0, 1, 2, 3].map((i) => (
    <rect x={WIN.x + 28} y={WIN.y + 78 + i * 36} width={WIN.w - 56 - (i % 2) * 84} height="16" rx="4"
          fill="currentColor" opacity="0.08" />
  ))}

  {TOOLS.map(({ label, glyph, at, to }) => {
    const rightSide = at.x > 500;
    return (
      <g>
        <path d={`M${at.x + (rightSide ? -34 : 34)} ${at.y} L${to.x} ${to.y}`}
              stroke="var(--accent)" stroke-width="2.5" opacity="0.85"
              marker-end="url(#bd-tip)" />
        <circle cx={at.x} cy={at.y} r="27" fill="var(--accent)" opacity="0.12" />
        <g transform={`translate(${at.x} ${at.y})`}>
          <path d={GLYPHS[glyph]} fill="none" stroke="var(--accent)" stroke-width="2.5" />
        </g>
        <text x={at.x} y={at.y + 58} text-anchor="middle" font-size={TYPE.sub}
              fill="currentColor" opacity="0.78">{label}</text>
      </g>
    );
  })}

  <marker id="bd-tip" markerUnits="userSpaceOnUse" markerWidth="12" markerHeight="12"
          refX="10" refY="6" orient="auto">
    <path d="M0 0 L11 6 L0 12 Z" fill="var(--accent)" />
  </marker>
</svg>
