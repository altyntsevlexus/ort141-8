---
/**
 * Slide 4 — «довжина > хитрість».
 *
 * Was a two-column table, which is exactly the failure this deck avoids: the
 * word «миттєво» next to the word «недосяжно» reads as two labels, not as a
 * gap. The bar does the arguing. The scale is deliberately not proportional —
 * a true one would make the first three bars invisible — so the caption says
 * so out loud rather than letting the picture claim precision it hasn't got.
 */
import { TYPE, VB, WARN } from './_shared';

const ROWS = [
  { pass: 'sunny12', note: '7 символів', time: 'миттєво', w: 22, tone: 'warn' },
  { pass: 'Qwerty1!', note: '8, але зі словника', time: 'миттєво', w: 22, tone: 'warn' },
  { pass: 'Tr7#kLp2', note: '8 випадкових', time: 'години', w: 300, tone: 'mid' },
  { pass: 'корова-парасолька-42', note: '20 символів', time: 'практично недосяжно', w: 930, tone: 'accent' },
] as const;

const FILL = { warn: WARN, mid: 'currentColor', accent: 'var(--accent)' } as const;
const OPACITY = { warn: 1, mid: 0.42, accent: 1 } as const;

const STEP = 98;
const TOP = 30;
const BAR_H = 20;
---
<svg viewBox={`0 0 ${VB.w} ${VB.h}`} role="img"
     aria-label="Час підбору пароля різко зростає з довжиною: 7–8 символів — миттєво, 20 символів — практично недосяжно">
  {ROWS.map(({ pass, note, time, w, tone }, i) => {
    const y = TOP + i * STEP;
    return (
      <g>
        <text x="0" y={y} font-size={TYPE.mono} font-family="var(--mono)" fill="currentColor">
          {pass}
        </text>
        <text x="0" y={y + 26} font-size={TYPE.note} fill="currentColor" opacity="0.5">
          {note}
        </text>
        <text x={VB.w} y={y} text-anchor="end" font-size={TYPE.sub}
              fill={tone === 'accent' ? 'var(--accent)' : 'currentColor'}
              opacity={tone === 'accent' ? 1 : 0.72}
              font-weight={tone === 'accent' ? 600 : 400}>
          {time}
        </text>
        <rect x="0" y={y + 40} width={w} height={BAR_H} rx={w < 60 ? 4 : BAR_H / 2}
              fill={FILL[tone]} opacity={OPACITY[tone]} />
        {/* The last bar does not end — it runs off the slide. */}
        {tone === 'accent' && (
          <g stroke="var(--accent)" stroke-width="3" fill="none" stroke-linecap="round">
            <path d={`M${w + 14} ${y + 42} l 8 8 l -8 8`} />
            <path d={`M${w + 30} ${y + 42} l 8 8 l -8 8`} opacity="0.5" />
            <path d={`M${w + 46} ${y + 42} l 8 8 l -8 8`} opacity="0.22" />
          </g>
        )}
      </g>
    );
  })}
  <text x="0" y={VB.h - 4} font-size={TYPE.note} fill="currentColor" opacity="0.45">
    довжина смуги — порядок величини, не пропорція
  </text>
</svg>
