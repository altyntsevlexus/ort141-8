---
/**
 * Slide 3 — three ways a program guesses a password.
 *
 * The names alone mean nothing to an eighth-grader; what makes it land is
 * seeing what the attempts actually look like. So each column shows a sample
 * of the stream, in monospace, trailing off.
 */
const WAYS = [
  {
    name: 'Груба сила',
    tries: ['aaaa', 'aaab', 'aaac', '…'],
    note: 'усі комбінації підряд',
  },
  {
    name: 'Словникова',
    tries: ['123456', 'qwerty', 'liverpool', '…'],
    note: 'спершу найпопулярніші',
  },
  {
    name: 'Підстановка',
    tries: ['ivan@ex.ua', 'sunny12', '↳ на 40 сайтах', '…'],
    note: 'готова пара з чужого витоку',
  },
];
---
<div class="pa">
  {WAYS.map(({ name, tries, note }) => (
    <div class="pa__col">
      <strong class="pa__name">{name}</strong>
      <ul class="pa__tries">
        {tries.map((t, i) => (
          <li style={`opacity: ${1 - i * 0.22}`}>{t}</li>
        ))}
      </ul>
      <span class="pa__note">{note}</span>
    </div>
  ))}
</div>

<style>
  .pa {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: max(14px, 2.2cqw);
    width: 100%;
    align-content: center;
  }
  .pa__col {
    display: flex;
    flex-direction: column;
    gap: max(8px, 1.1cqw);
    padding: max(12px, 1.6cqw) max(14px, 1.8cqw);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .pa__name {
    font-size: max(15px, 1.95cqw);
    font-weight: 600;
    color: var(--accent);
  }
  .pa__tries {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: max(12px, 1.5cqw);
    line-height: 1.6;
  }
  .pa__note {
    font-size: max(11px, 1.4cqw);
    opacity: 0.62;
  }

  @container (max-width: 620px) {
    .pa {
      grid-template-columns: 1fr;
    }
    .pa__tries {
      display: flex;
      gap: 0 14px;
      flex-wrap: wrap;
    }
  }
</style>
