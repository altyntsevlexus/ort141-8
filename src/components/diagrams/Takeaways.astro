---
/**
 * Slide 18 — the three things to leave with.
 *
 * Built as a CSS grid of icon + label rather than pure SVG: the labels are
 * whole sentences, and SVG text does not wrap, so the browser has to measure
 * them. The icons are still SVG, drawn into a shared 120×96 box.
 */
import { WARN } from './_shared';
---
<div class="tw">
  <div class="tw__item">
    <svg viewBox="0 0 120 96" aria-hidden="true">
      <!-- A password, plus a second factor: the two together are the habit. -->
      <g fill="none" stroke="var(--accent)" stroke-width="3.5">
        <rect x="10" y="40" width="34" height="28" rx="4" />
        <path d="M18 40 v-8 a9 9 0 0 1 18 0 v8" />
        <path d="M56 54 h14 M63 47 v14" />
        <rect x="80" y="30" width="30" height="48" rx="5" />
      </g>
      <g fill="var(--accent)">
        {[0, 1, 2].map((i) => <circle cx={87 + i * 8} cy="50" r="2.6" />)}
        <rect x="87" y="60" width="16" height="4" rx="2" opacity="0.5" />
      </g>
    </svg>
    <span>Май різні паролі та вмикай двофакторну автентифікацію</span>
  </div>

  <div class="tw__item">
    <svg viewBox="0 0 120 96" aria-hidden="true">
      <!-- A file with something in it: install programs from where you should. -->
      <path d="M38 20 h30 l14 14 v42 h-44 z" fill="#fff"
            stroke="currentColor" stroke-width="3" />
      <path d="M68 20 v14 h14" fill="none" stroke="currentColor" stroke-width="3" />
      <g stroke="currentColor" stroke-width="3" opacity="0.28" stroke-linecap="round">
        <path d="M46 48 h18" />
        <path d="M46 57 h24" />
      </g>
      <circle cx="72" cy="66" r="9" fill={WARN} />
      <path d="M72 61 v6" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="72" cy="71" r="1.4" fill="#fff" />
    </svg>
    <span>Безпечно користуйся програмами</span>
  </div>

  <div class="tw__item">
    <svg viewBox="0 0 120 96" aria-hidden="true">
      <!-- A voice, and no way to tell whose. -->
      {[26, 38, 50, 62].map((x, i) => {
        const h = [22, 44, 60, 32][i];
        return <rect x={x} y={48 - h / 2} width="7" height={h} rx="3.5"
                     fill="var(--accent)" opacity="0.55" />;
      })}
      <text x="88" y="62" text-anchor="middle" font-size="48" font-weight="700"
            fill="var(--accent)">?</text>
    </svg>
    <span>ШІ — нова загроза, яку треба вміти відрізняти</span>
  </div>
</div>

<style>
  .tw {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: max(16px, 2.6cqw);
    width: 100%;
    align-items: start;
  }
  .tw__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: max(8px, 1.2cqw);
    text-align: center;
  }
  .tw__item svg {
    width: max(84px, 17cqw);
    height: auto;
    overflow: visible;
  }
  .tw__item span {
    font-size: max(13px, 1.72cqw);
    font-weight: 600;
    line-height: 1.3;
    max-width: 24ch;
  }

  @container (max-width: 620px) {
    .tw {
      grid-template-columns: 1fr;
    }
    .tw__item {
      flex-direction: row;
      text-align: left;
      gap: max(12px, 1.6cqw);
    }
    .tw__item svg {
      width: max(52px, 9cqw);
      flex-shrink: 0;
    }
  }
</style>
