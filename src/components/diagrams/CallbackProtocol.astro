---
/**
 * Slide 18 — what to actually do when the voice on the phone asks for money.
 *
 * Three steps, in order, because the order is the whole protocol: the second
 * step is hanging up, and that is the one people skip.
 */
const STEPS = [
  { n: '1', label: 'Дзвінок «від рідних»', note: 'тиск, поспіх, гроші' },
  { n: '2', label: 'Покласти слухавку', note: 'це не грубість' },
  { n: '3', label: 'Передзвонити самому', note: 'на номер, який ви знаєте' },
];
---
<div class="cb">
  {STEPS.map(({ n, label, note }, i) => (
    <>
      {i > 0 && <span class="cb__arrow"></span>}
      <div class="cb__step">
        <span class="cb__n">{n}</span>
        <strong class="cb__label">{label}</strong>
        <span class="cb__note">{note}</span>
      </div>
    </>
  ))}
</div>

<style>
  .cb {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: max(10px, 1.4cqw);
    width: 100%;
  }
  .cb__step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: max(6px, 0.8cqw);
    padding: max(14px, 1.9cqw) max(12px, 1.6cqw);
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    text-align: center;
  }
  .cb__n {
    display: grid;
    place-items: center;
    width: max(26px, 3.2cqw);
    height: max(26px, 3.2cqw);
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--mono);
    font-size: max(14px, 1.8cqw);
    font-weight: 600;
  }
  .cb__label {
    font-size: max(14px, 1.85cqw);
    font-weight: 600;
    line-height: 1.25;
  }
  .cb__note {
    font-size: max(11px, 1.4cqw);
    opacity: 0.62;
  }
  .cb__arrow {
    align-self: center;
    flex-shrink: 0;
    width: max(9px, 1.1cqw);
    height: max(9px, 1.1cqw);
    border-top: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
    transform: rotate(45deg);
    opacity: 0.5;
  }

  @container (max-width: 620px) {
    .cb {
      flex-direction: column;
    }
    .cb__arrow {
      transform: rotate(135deg);
    }
  }
</style>
