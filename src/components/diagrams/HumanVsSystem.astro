---
/**
 * Slide 2 — last lesson the target was a person; this lesson it is a machine.
 * The two panels are deliberately the same size: neither attack is the small one.
 */
import { TYPE, VB } from './_shared';
---
<svg viewBox={`0 0 ${VB.w} ${VB.h}`} role="img"
     aria-label="Урок 1 — атака на людину; урок 2 — атака на систему">
  <!-- Урок 1: a person and the words aimed at them. -->
  <rect x="20" y="50" width="450" height="250" rx="14"
        fill="currentColor" opacity="0.04" />
  <text x="245" y="34" text-anchor="middle" font-size={TYPE.note}
        font-family="var(--mono)" fill="currentColor" opacity="0.5">УРОК 1</text>
  <circle cx="205" cy="140" r="26" fill="none" stroke="currentColor" stroke-width="2.5" />
  <path d="M165 218 a 40 42 0 0 1 80 0" fill="none" stroke="currentColor" stroke-width="2.5" />
  <path d="M268 108 h 118 a 10 10 0 0 1 10 10 v 52 a 10 10 0 0 1 -10 10 h -84 l -22 20 v -20 h -12 a 10 10 0 0 1 -10 -10 v -52 a 10 10 0 0 1 10 -10 z"
        fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.75" />
  <text x="327" y="156" text-anchor="middle" font-size="34" font-weight="700"
        fill="currentColor" opacity="0.6">!</text>
  <text x="245" y="272" text-anchor="middle" font-size={TYPE.sub}
        fill="currentColor" opacity="0.72">атака на довіру</text>

  <!-- Урок 2: a device, and the switch nobody turned on. -->
  <rect x="530" y="50" width="450" height="250" rx="14"
        fill="var(--accent)" opacity="0.07" />
  <text x="755" y="34" text-anchor="middle" font-size={TYPE.note}
        font-family="var(--mono)" fill="var(--accent)" opacity="0.85">УРОК 2</text>
  <rect x="672" y="104" width="166" height="106" rx="8"
        fill="none" stroke="var(--accent)" stroke-width="2.5" />
  <path d="M648 226 h 214 l -18 -16 h -178 z" fill="none" stroke="var(--accent)" stroke-width="2.5" />
  <!-- A setting, switched off. -->
  <rect x="712" y="142" width="62" height="30" rx="15"
        fill="none" stroke="var(--accent)" stroke-width="2.5" opacity="0.8" />
  <circle cx="727" cy="157" r="9" fill="var(--accent)" opacity="0.8" />
  <text x="755" y="272" text-anchor="middle" font-size={TYPE.sub}
        fill="currentColor" opacity="0.72">атака на пристрій</text>
</svg>
