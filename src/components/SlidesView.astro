---
import { render } from 'astro:content';
import SlideVisual from './SlideVisual.astro';
import Sources from './Sources.astro';
import { mdxComponents } from './mdx-components';
import type { Course, Theme } from '../lib/nav';

interface Props {
  course: Course;
  theme: Theme;
  number: number;
}
const { course, theme, number } = Astro.props;
const slides = theme.data.slides ?? [];
const sources = theme.data.sources ?? [];
const hasSupport = (theme.body ?? '').trim().length > 0;
const { Content } = await render(theme);
const { color, tint } = course.data;
---
<main class="shell page" style="padding-top: 36px; padding-bottom: 80px">
  <div class="theme-kicker" style={`color: ${color}`}>
    Тема {number} · Презентація
  </div>
  <h1 class="theme-title">{theme.data.title}</h1>

  {
    slides.length > 0 ? (
      <div class="deck" data-deck data-total={slides.length}>
        {slides.map((slide, i) => (
          <div
            class={i === 0 ? 'slide is-active' : 'slide'}
            style={`background: ${tint}; --accent: ${color}`}
            data-slide={i}
          >
            <div class="slide__inner">
              <div class="slide__head">
                <div class="slide__kicker" style={`color: ${color}`}>{slide.kicker}</div>
                <h2>{slide.title}</h2>
              </div>
              {slide.visual && <SlideVisual visual={slide.visual} />}
              {slide.anchors && slide.anchors.length > 0 && (
                <div class="slide__anchors">
                  {slide.anchors.map((text) => (
                    <span class="slide__anchor">
                      <span data-dot style={`background: ${color}`} />
                      {text}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
        <div class="deck__bar">
          <button class="deck__nav" data-prev aria-label="Попередній слайд">←</button>
          <div class="deck__count" data-count>1 / {slides.length}</div>
          <button class="deck__nav" data-next aria-label="Наступний слайд">→</button>
          <button class="deck__full" data-full>На весь екран</button>
        </div>
      </div>
    ) : (
      <p class="empty-note">Слайди ще не додано.</p>
    )
  }

  {hasSupport && (
    <section class="support prose">
      <Content components={mdxComponents} />
    </section>
  )}

  <slot />
</main>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');

  if (deck) {
    const slides = [...deck.querySelectorAll<HTMLElement>('[data-slide]')];
    const prev = deck.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-next]')!;
    const count = deck.querySelector<HTMLElement>('[data-count]')!;
    const full = deck.querySelector<HTMLButtonElement>('[data-full]')!;
    let at = 0;

    // --- Stepping. Does not wrap, so the ends of the deck are visible. ---

    const show = (i: number) => {
      at = Math.min(Math.max(i, 0), slides.length - 1);
      slides.forEach((s, k) => s.classList.toggle('is-active', k === at));
      count.textContent = `${at + 1} / ${slides.length}`;
      prev.disabled = at === 0;
      next.disabled = at === slides.length - 1;
    };

    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));

    // --- Fullscreen. ---

    // Safari still needs the webkit-prefixed API; iOS Safari has neither for
    // ordinary elements, so that platform falls back to a fixed overlay.
    type WebkitEl = HTMLElement & { webkitRequestFullscreen?: () => Promise<void> };
    type WebkitDoc = Document & {
      webkitFullscreenElement?: Element | null;
      webkitExitFullscreen?: () => Promise<void>;
    };
    const doc = document as WebkitDoc;
    const el = deck as WebkitEl;

    const nativeSupported = !!(el.requestFullscreen || el.webkitRequestFullscreen);
    const nativeActive = () =>
      (doc.fullscreenElement ?? doc.webkitFullscreenElement) === deck;
    const isFull = () => deck.classList.contains('deck-full');

    // While presenting, the control bar gets out of the way until the mouse
    // moves. Cleared on exit so a windowed deck never hides its own controls.
    let idle: ReturnType<typeof setTimeout> | undefined;
    const stirIdle = () => {
      clearTimeout(idle);
      deck.classList.remove('is-idle');
      if (isFull()) idle = setTimeout(() => deck.classList.add('is-idle'), 2500);
    };
    deck.addEventListener('pointermove', stirIdle);
    deck.addEventListener('pointerdown', stirIdle);

    const paint = (on: boolean) => {
      deck.classList.toggle('deck-full', on);
      full.textContent = on ? 'Згорнути' : 'На весь екран';
      full.setAttribute('aria-pressed', String(on));
      if (on) stirIdle();
      else {
        clearTimeout(idle);
        deck.classList.remove('is-idle');
      }
    };

    const enter = async () => {
      if (nativeSupported) {
        try {
          await (el.requestFullscreen?.() ?? el.webkitRequestFullscreen?.());
          return; // fullscreenchange paints.
        } catch {
          // Denied or unsupported in practice — fall through to the overlay.
        }
      }
      deck.classList.add('is-immersive');
      document.body.classList.add('is-immersive-lock');
      paint(true);
    };

    const exit = async () => {
      if (nativeActive()) {
        await (doc.exitFullscreen?.() ?? doc.webkitExitFullscreen?.());
        return; // fullscreenchange paints.
      }
      deck.classList.remove('is-immersive');
      document.body.classList.remove('is-immersive-lock');
      paint(false);
    };

    full.addEventListener('click', () => (isFull() ? exit() : enter()));

    // The browser can leave fullscreen on its own (Esc, window switch), so the
    // button label follows the actual state rather than what we last asked for.
    const onChange = () => paint(nativeActive());
    document.addEventListener('fullscreenchange', onChange);
    document.addEventListener('webkitfullscreenchange', onChange);

    // Advancing by clicking the slide is a presenting convenience, so it only
    // applies when actually presenting.
    slides.forEach((s) =>
      s.addEventListener('click', () => {
        if (isFull()) show(at + 1);
      }),
    );

    // Exercise tables hide their answers until asked. Clicking a row reveals it;
    // clicking the slide background still advances, so this stops propagation.
    deck.querySelectorAll<HTMLElement>('td.is-hidden').forEach((cell) => {
      cell.addEventListener('click', (e) => {
        e.stopPropagation();
        cell.classList.toggle('is-shown');
      });
    });

    // --- Keyboard. ---

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(at - 1);
      if (e.key === 'ArrowRight' || e.key === 'PageDown') show(at + 1);
      if (e.key === ' ') {
        // Space is page-scroll by default; only claim it while presenting.
        if (isFull()) {
          e.preventDefault();
          show(at + 1);
        }
      }
      if (e.key === 'f' && !isFull()) enter();
      // Native fullscreen handles its own Esc; the overlay fallback does not.
      if (e.key === 'Escape' && isFull() && !nativeActive()) exit();
    });

    show(0);
  }
</script>
