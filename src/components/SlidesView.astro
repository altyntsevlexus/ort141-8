---
import type { Course, Theme } from '../lib/nav';

interface Props {
  course: Course;
  theme: Theme;
  number: number;
}
const { course, theme, number } = Astro.props;
const slides = theme.data.slides ?? [];
const { color, tint } = course.data;
---
<main class="shell page" style="padding-top: 36px; padding-bottom: 80px">
  <div class="theme-kicker" style={`color: ${color}`}>
    Тема {number} · Презентація
  </div>
  <h1 class="theme-title">{theme.data.title}</h1>

  {
    slides.length > 0 ? (
      <div class="deck" data-deck data-total={slides.length}>
        {slides.map((slide, i) => (
          <div
            class={i === 0 ? 'slide is-active' : 'slide'}
            style={`background: ${tint}`}
            data-slide={i}
          >
            <div class="slide__kicker" style={`color: ${color}`}>{slide.kicker}</div>
            <h2>{slide.title}</h2>
            <div class="slide__bullets">
              {slide.bullets.map((text) => (
                <div class="slide__bullet">
                  <span data-dot style={`background: ${color}`}></span>
                  <div>{text}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
        <div class="deck__bar">
          <button class="deck__nav" data-prev aria-label="Попередній слайд">←</button>
          <div class="deck__count" data-count>1 / {slides.length}</div>
          <button class="deck__nav" data-next aria-label="Наступний слайд">→</button>
        </div>
      </div>
    ) : (
      <p class="empty-note">Слайди ще не додано.</p>
    )
  }

  <slot />
</main>

<script>
  // Slides step within the deck; unlike the prototype they do not wrap, so the
  // end of a deck is visible rather than looping silently back to slide 1.
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const slides = [...deck.querySelectorAll<HTMLElement>('[data-slide]')];
    const prev = deck.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-next]')!;
    const count = deck.querySelector<HTMLElement>('[data-count]')!;
    let at = 0;

    const show = (i: number) => {
      at = Math.min(Math.max(i, 0), slides.length - 1);
      slides.forEach((s, k) => s.classList.toggle('is-active', k === at));
      count.textContent = `${at + 1} / ${slides.length}`;
      prev.disabled = at === 0;
      next.disabled = at === slides.length - 1;
    };

    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      if (e.key === 'ArrowRight') show(at + 1);
    });

    show(0);
  }
</script>
