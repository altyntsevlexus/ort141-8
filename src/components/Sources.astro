---
interface Source {
  label: string;
  note?: string;
  href?: string;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---
{
  sources.length > 0 && (
    <section class="sources">
      <div class="mono-label" style="margin-bottom: 12px">Джерела</div>
      <ul class="sources__list">
        {sources.map((s) => (
          <li>
            {s.href ? (
              <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
            ) : (
              <span>{s.label}</span>
            )}
            {s.note && <span class="sources__note"> — {s.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}
